[
{{ $pages := ((where site.RegularPages "Type" "news").ByParam "published_date").Reverse }}
{{ range $i, $p := $pages }}{{ if $i }},{{ end }}
{{ $reporter := "" }}
{{ with $p.Params.author }}{{ $rp := site.GetPage (printf "/team/%s" .) }}{{ with $rp }}{{ $reporter = .Params.name }}{{ end }}{{ end }}
{
  "title": {{ $p.Title | jsonify }},
  "url": {{ $p.RelPermalink | jsonify }},
  "category": {{ $p.Params.category | jsonify }},
  "summary": {{ ($p.Params.summary | default $p.Summary) | jsonify }},
  "reporter": {{ $reporter | jsonify }},
  "tags": {{ $p.Params.tags | jsonify }},
  "date": {{ ($p.Params.published_date | time.Format "Jan 2, 2006") | jsonify }}
}
{{ end }}
]
