{{- $list := slice -}}
{{- $indexed := where site.RegularPages "Type" "in" (slice "news" "opinion" "special-reports") -}}
{{- range ($indexed.ByParam "published_date").Reverse -}}
  {{- $reporter := "" -}}
  {{- with .Params.author -}}
    {{- with site.GetPage (printf "/team/%s" .) }}{{ $reporter = .Params.name }}{{ end -}}
  {{- end -}}
  {{- $dateStr := "" -}}
  {{- with .Params.published_date }}{{ $dateStr = . | time.Format "Jan 2, 2006" }}{{ end -}}
  {{- $category := .Params.category -}}
  {{- if not $category }}{{ with .CurrentSection }}{{ $category = .Title }}{{ end }}{{ end -}}
  {{- $image := "" -}}
  {{- with .Params.image }}{{ $image = . | relURL }}{{ end -}}
  {{- $item := dict "image" $image "image_alt" (.Params.image_alt | default "") "title" .Title "url" .RelPermalink "category" $category "summary" (.Params.summary | default .Summary) "reporter" $reporter "tags" .Params.tags "date" $dateStr -}}
  {{- $list = $list | append $item -}}
{{- end -}}
{{- $list | jsonify (dict "indent" "  ") -}}
