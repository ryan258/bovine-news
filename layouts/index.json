{{- $pages := ((where site.RegularPages "Type" "news").ByParam "published_date").Reverse -}}
{{- $list := slice -}}
{{- range $pages -}}
  {{- $reporter := "" -}}
  {{- with .Params.author -}}
    {{- $rp := site.GetPage (printf "/team/%s" .) -}}
    {{- with $rp }}{{ $reporter = .Params.name }}{{ end -}}
  {{- end -}}
  {{- $dateStr := "" -}}
  {{- with .Params.published_date }}{{ $dateStr = . | time.Format "Jan 2, 2006" }}{{ end -}}
  {{- $item := dict "title" .Title "url" .RelPermalink "category" .Params.category "summary" (.Params.summary | default .Summary) "reporter" $reporter "tags" .Params.tags "date" $dateStr -}}
  {{- $list = $list | append $item -}}
{{- end -}}
{{- $list | jsonify (dict "indent" "  ") -}}

